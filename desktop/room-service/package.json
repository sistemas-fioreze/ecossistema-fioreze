{
  "name": "@fioreze/room-service-desktop",
  "version": "1.1.3",
  "private": true,
  "description": "Fioreze ERP para Windows com integracao segura ao gerenciador de impressao.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "dist:win": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "43.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "br.com.hoteisfioreze.roomservice.erp",
    "productName": "Fioreze ERP",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "runtime.cjs",
      "window-chrome.cjs",
      "unconfigured.html",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  },
  "allowScripts": {
    "electron@43.1.0": true
  },
  "overrides": {
    "@electron/get": {
      "undici": "7.29.0"
    }
  }
}
